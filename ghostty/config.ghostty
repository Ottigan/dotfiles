# ── Theme ─────────────────────────────────────────────
theme = TokyoNight Night
window-theme = ghostty

# ── Misc ─────────────────────────────────────────────
confirm-close-surface = false
notify-on-command-finish-action = no-bell,notify

# ── Shell Integration ─────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Window ────────────────────────────────────────────
background-opacity = 0.9
background-blur = false
unfocused-split-opacity = 0.5
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-decoration = true
window-save-state = always
initial-window = true
maximize = true

# ── Font ──────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font Mono
adjust-cell-width = -5%
adjust-underline-position = 6
adjust-underline-thickness = 40%
# ==> != ++ := ->> !== -->
adjust-cell-height = 35%
font-thicken = false
font-size = 10

# ── Cursor ────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Mouse ─────────────────────────────────────────────
mouse-hide-while-typing = true

# ── Clipboard ────────────────────────────────────────
copy-on-select = clipboard
clipboard-paste-protection = true

# ── MacOS Specific ───────────────────────────────────
macos-non-native-fullscreen = true
macos-window-buttons = hidden
macos-titlebar-style = tabs
macos-window-shadow = true
macos-option-as-alt = true
quit-after-last-window-closed = true

# ── Keybinds ───────────────────────────────────
keybind = alt+shift+w=toggle_command_palette
keybind = alt+w=close_surface
keybind = alt+d=new_split:right
keybind = shift+alt+d=new_split:down
keybind = shift+cmd+h=goto_split:left
keybind = shift+alt+h=goto_split:left
keybind = shift+cmd+l=goto_split:right
keybind = shift+alt+l=goto_split:right
keybind = shift+cmd+j=goto_split:down
keybind = shift+alt+j=goto_split:down
keybind = shift+cmd+k=goto_split:up
keybind = shift+alt+k=goto_split:up
keybind = cmd+i=inspector:toggle
keybind = cmd+alt+h=resize_split:left,10
keybind = cmd+alt+l=resize_split:right,10
keybind = cmd+r=prompt_tab_title
keybind = alt+r=prompt_tab_title
keybind = super+,=text:nvim ~/.config/ghostty/config.ghostty\n
keybind = ctrl+,=text:nvim ~/.config/ghostty/config.ghostty\n
keybind = global:cmd+§=toggle_visibility
