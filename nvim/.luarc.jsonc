{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      // Runtime and builtin libraries.
      "$VIMRUNTIME/lua",
      "${3rd}/luv/library",
      // Include some plugins for API completion.
      "$XDG_DATA_HOME/nvim/lazy/blink.cmp/lua",
      "$XDG_DATA_HOME/nvim/lazy/blink.lib/lua",
      "$XDG_DATA_HOME/nvim/lazy/gitlinker.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/lazy.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/nvim-autopairs/lua",
      "$XDG_DATA_HOME/nvim/lazy/nvim-dap/lua",
      "$XDG_DATA_HOME/nvim/lazy/snacks.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/conform.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/tokyonight.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/render-markdown.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/persistence.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/mini.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/fzf-lua/lua",
      "$XDG_DATA_HOME/nvim/lazy/bufferline.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/noice.nvim/lua",
      "$XDG_DATA_HOME/nvim/lazy/neotest/lua",
      "$XDG_DATA_HOME/nvim/lazy/neotest-jest/lua"
    ]
  }
}
