--smart-case
--colors=match:fg:green
--colors=line:fg:yellow
--colors=line:style:bold
--colors=path:fg:cyan
--column
--heading
--line-number
--max-columns=150
--max-columns-preview
--context-separator=---
--max-filesize=50M
--mmap
--no-ignore-messages
--follow
--hidden
--type-add=config:*.{yml,yaml,toml,json,ini,conf,cfg}
--type-add=script:*.{sh,bash,zsh,fish,ps1,py,rb,pl}
--type-add=doc:*.{md,org,rst,txt,tex,adoc}
--glob=!.git/
--glob=!*.min.js
--glob=!*.min.css
--glob=!*.map
--glob=!*.lock
--glob=!*.log
--glob=!*.tmp
--glob=!*.bak
