## js-clients package session template, rendered by ./render into ../sessions/<package>.kitty-session.
## Lines starting with ## are template-only. Placeholders:
##   @NAME@  package name, e.g. evo-ls3
##   @ROOT@  package worktree, e.g. ~/Documents/js-clients.worktrees/evo-ls3
##   @PKG@   package path inside the worktree, e.g. packages/games-evo/evo-ls3
# @NAME@: generated by session-templates/render from js-clients.template; edit the template and rerun.
os_window_state maximized

new_tab Editor
layout splits
cd @ROOT@
launch zsh -ic 'v .; exec zsh'
focus

new_tab Lazygit
layout splits
cd @ROOT@
launch zsh -ic 'lg; exec zsh'
focus

new_tab Shell
layout splits
cd @ROOT@/@PKG@
launch --var pane=shell
launch --location=vsplit
launch --location=hsplit --cwd=@ROOT@
focus_matching_window var:pane=shell

new_tab Claude
layout splits
cd @ROOT@
launch zsh -ic 'claude; exec zsh'
focus

focus_tab 0
